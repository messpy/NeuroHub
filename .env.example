# NeuroHub 環境変数設定例
# このファイルを .env にコピーして使用してください
# コピー: cp .env.example .env

# ===== LLM API Keys =====

# Gemini API Key（無料プラン: 1日250リクエスト）
# 取得: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace API Key（無料プラン: 月間制限あり）
# 取得: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ===== Ollama設定 =====

# Ollama APIエンドポイント
# ローカル: http://localhost:11434
# Docker: http://ollama:11434
OLLAMA_HOST=http://localhost:11434

# ===== Discord Bot（オプション） =====

# Discord Bot Token
# 取得: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Channel ID
DISCORD_CHANNEL_ID=your_channel_id_here

# ===== Nature Remo（オプション） =====

# Nature Remo API Token
# 取得: https://home.nature.global/
NATURE_REMO_TOKEN=your_nature_remo_token_here

# ===== アプリケーション設定 =====

# ログレベル（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# データベースパス
DATABASE_PATH=neurohub_llm.db

# ===== 開発環境設定 =====

# 開発モード（true/false）
DEBUG=false

# テストモード（true/false）
TEST_MODE=false
